# Copy to .env.local. Every variable is OPTIONAL: with none set the site runs
# fully locally (JSON files under ./data, development login, mock AI).
# Mock output is always labelled as such in the UI.

# --- Site -------------------------------------------------------------------
# Public origin, used for absolute links (share links, metadata, sitemap) and,
# in Supabase mode, for the magic-link and Google sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MUST be the real https domain in production, or every canonical URL and the
# sitemap point to localhost. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is the fallback.

# --- Search engines & analytics ----------------------------------------------
# Content of the verification meta tag from Google Search Console / Bing Webmaster.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Cookieless analytics (no consent banner needed, nothing personal about children).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible script URL. Default: https://plausible.io/js/script.js
# NEXT_PUBLIC_PLAUSIBLE_SRC=
# Folder for local JSON data and media. Default: ./data
# DATA_DIR=
# The service worker (offline reading, install prompt) registers only in
# production builds. Set to 1 to try it in `next dev` as well.
# NEXT_PUBLIC_ENABLE_SW=1

# --- Auth (local mode) ---------------------------------------------------------
# Secret that signs the session cookie. Without it a random secret is created
# in data/.auth-secret and a warning is printed. Always set it when deploying.
# AUTH_SECRET=
# Comma separated emails that get the admin role (local AND Supabase mode).
# ADMIN_EMAILS=me@example.com
# The password-less development login is refused when NODE_ENV=production
# (`npm start`) unless this is set to 1. Never set it on a public site.
# ALLOW_DEV_LOGIN=1

# --- Supabase (data, auth and storage) --------------------------------------------
# When both public variables are set, getRepo(), getMediaStore() and the auth
# helpers switch to the Supabase implementations
# (src/lib/{repo,media,auth}/supabase.ts), and /login becomes /auth/sign-in.
# SUPABASE_SERVICE_ROLE_KEY is then REQUIRED (server only, never NEXT_PUBLIC):
# the server reads and writes with it and authorises in application code.
# Setup steps are in README.md. NOTE: this backend has never been run against
# a real Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI: story text (Gemini) --------------------------------------------------------
# Gemini is the site's one story writer. Unset = mock provider that returns one
# fixed sample story (the idea is ignored and the book says so). Every story is
# written in the house voice: rhymed, Dr. Seuss mechanisms (src/lib/generation/seuss.ts).
# A Google AI Studio key used for story text ONLY. Each service has its own key
# (TEXT / TTS / IMAGE / VIDEO, no fallbacks) so the bills stay separate.
# Tip: one Google Cloud project per key, to see each cost under its own project.
# TEXT_API_KEY=
# Default: gemini-3.8-flash
# TEXT_MODEL=
# "gemini" (default when a key exists), "mock", or "claude" (old option, needs ANTHROPIC_API_KEY).
# TEXT_PROVIDER=gemini
# ANTHROPIC_API_KEY also enables text recognition (OCR) on /studio/import, which
# sends page images to the Claude API; without it the OCR buttons are hidden.
# ANTHROPIC_API_KEY=
# Default: claude-opus-5-5
# ANTHROPIC_MODEL=

# --- AI: nikud (vocalization) ---------------------------------------------------------
# "dicta" enables the Dicta Nakdan provider. Unset = mock (text is returned
# unchanged and never stored as vocalized text).
# NIKUD_PROVIDER=dicta
# Default: https://nakdan-u2-1a.loadbalancer.dicta.org.il/api
# This is the unauthenticated endpoint behind Dicta's own web tool (no key);
# it is not a contracted API and may change or be rate limited.
# DICTA_API_URL=

# --- AI: text to speech ------------------------------------------------------------------
# Unset = mock (silent audio with evenly spaced word timings, shown with a
# "demo voice" notice). Vendors: "gemini" (Google AI Studio, the same key as text
# and pictures) or "elevenlabs"; any other value throws a clear error.
# TTS_PROVIDER=gemini
# gemini: AI Studio key for voice only. elevenlabs: the ElevenLabs API key.
# TTS_API_KEY=
# gemini: default prebuilt voice name, default Sulafat (narrators can pick others
# in the studio). elevenlabs: REQUIRED voice id, no default.
# TTS_VOICE=
# Default gemini-3.8-flash-tts (gemini; lists Hebrew) / eleven_v3 (elevenlabs).
# TTS_MODEL=
# Gemini notes: the narration style AND the free-text notes are sent as a spoken-style
# instruction (never read aloud). Gemini returns no word timings, so the
# highlighting uses ESTIMATED timings spread over the real audio length; for exact
# ones run scripts/align-recordings.ts with STT_PROVIDER configured (never automatic).
# ElevenLabs only below:
# Optional data residency: us | eu | in | sg
# TTS_REGION=
# Default: mp3_44100_128. Only mp3_* and wav_* formats are accepted.
# TTS_OUTPUT_FORMAT=
# 1 = send the text to the vendor without nikud.
# TTS_STRIP_NIKUD=1

# --- AI: illustrations ---------------------------------------------------------------------
# Unset = mock (a labelled SVG placeholder). The only implemented vendor is
# "gemini" (Google Interactions API); any other value throws
# ProviderNotImplementedError.
# IMAGE_PROVIDER=gemini
# A Google AI Studio key.
# IMAGE_API_KEY=
# Default: gemini-nano-banana-2.1
# IMAGE_MODEL=
# Picture size sent to the model: 1K, 2K or 4K. Default 1K. 2K gives sharper pictures (a 3x3 grid then has
# panels of about 680 px instead of 340 px) but costs more per picture: update COST_IMAGE_USD below.
# IMAGE_SIZE=1K

# --- AI: living illustrations (image to video) -------------------------------------------
# Turns a page illustration into a short silent looping clip. Unset = mock (a
# tiny placeholder MP4, labelled as a sample). The only implemented vendor is
# "gemini" (Google Veo through the Gemini API); any other value throws
# ProviderNotImplementedError. Paid: about $0.05 per second with the default
# lite model at 720p (a 4 s clip is about $0.20), billed only on success.
# VIDEO_PROVIDER=gemini
# A Google AI Studio key for video only (required, no fallback).
# VIDEO_API_KEY=
# Default: veo-3.1-lite-generate-preview. Also: veo-3.1-fast-generate-preview
# ($0.10/s), veo-3.1-generate-preview ($0.40/s).
# VIDEO_MODEL=

# --- AI limits and scheduling ------------------------------------------------------------------
# AI books a parent may create per rolling 7 days. Default 1. Admins are unlimited.
# AI_WEEKLY_QUOTA=1
# Shared secret for the scheduled daily story. The scheduler calls
#   POST /api/generate/daily   with header   Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# --- Rate limits --------------------------------------------------------------------------------
# Requests per hour, per signed-in user (per IP address for anonymous callers).
# Editors and admins are not limited. A whole number; 0 blocks the endpoint,
# "off" removes the limit. The values below are the defaults.
# NOTE: the counters live in the memory of one server process. With several
# instances each one counts separately; see "Known gaps" in README.md.
# RATE_LIMIT_NARRATION_PER_HOUR=30
# RATE_LIMIT_NIKUD_PER_HOUR=400
# RATE_LIMIT_OCR_PER_HOUR=150
# RATE_LIMIT_TRANSLATE_PER_HOUR=60
# RATE_LIMIT_ILLUSTRATE_PER_HOUR=60
# RATE_LIMIT_PDF_PER_HOUR=60
# RATE_LIMIT_VIEWS_PER_HOUR=120
# Voice ids a narration request may choose besides TTS_VOICE (comma separated).
# With gemini the studio's built-in voice list is allowed too. Any other id is refused.
# RATE_LIMIT_SAMPLE_PER_HOUR=20
# TTS_ALLOWED_VOICES=

# --- Free book import ---------------------------------------------------------------------------
# Optional GitHub token for the Book Dash importer (npm run import:bookdash, /admin/import).
# It only raises the limit of the catalogue listing (60 requests an hour without it).
# GITHUB_TOKEN=

# --- Cost estimates in the studio ("עלות משוערת") ------------------------------------------------
# Prices live in src/lib/generation/costs.ts (read from Google/ElevenLabs on 2026-10-19). Override any
# of them in USD if your plan differs. The estimate never includes retries.
# COST_TEXT_IN_PER_M=0.75
# COST_TEXT_OUT_PER_M=3.75
# COST_IMAGE_USD=0.0336
# COST_TTS_PER_1K_CHARS=0.02
# COST_VIDEO_PER_SECOND=0.05
# COST_USD_TO_ILS=3.7
