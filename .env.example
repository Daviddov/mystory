# Copy to .env.local. Every variable is OPTIONAL: with none set the site runs
# fully locally (JSON files under ./data, development login, mock AI).
# Mock output is always labelled as such in the UI.

# --- Site -------------------------------------------------------------------
# Public origin, used for absolute links (share links, metadata, sitemap) and,
# in Supabase mode, for the magic-link and Google sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Folder for local JSON data and media. Default: ./data
# DATA_DIR=
# The service worker (offline reading, install prompt) registers only in
# production builds. Set to 1 to try it in `next dev` as well.
# NEXT_PUBLIC_ENABLE_SW=1

# --- Auth (local mode) ---------------------------------------------------------
# Secret that signs the session cookie. Without it a random secret is created
# in data/.auth-secret and a warning is printed. Always set it when deploying.
# AUTH_SECRET=
# Comma separated emails that get the admin role (local AND Supabase mode).
# ADMIN_EMAILS=me@example.com
# The password-less development login is refused when NODE_ENV=production
# (`npm start`) unless this is set to 1. Never set it on a public site.
# ALLOW_DEV_LOGIN=1

# --- Supabase (data, auth and storage) --------------------------------------------
# When both public variables are set, getRepo(), getMediaStore() and the auth
# helpers switch to the Supabase implementations
# (src/lib/{repo,media,auth}/supabase.ts), and /login becomes /auth/sign-in.
# SUPABASE_SERVICE_ROLE_KEY is then REQUIRED (server only, never NEXT_PUBLIC):
# the server reads and writes with it and authorises in application code.
# Setup steps are in README.md. NOTE: this backend has never been run against
# a real Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI: story text (Claude) --------------------------------------------------------
# Unset = mock provider that returns one fixed sample story (the parent's idea
# is ignored and the book says so). The key also enables text recognition (OCR)
# on /studio/import, which sends page images to the Claude API; without the
# key the OCR buttons are hidden.
# ANTHROPIC_API_KEY=
# Default: claude-opus-5-5
# ANTHROPIC_MODEL=

# --- AI: nikud (vocalization) ---------------------------------------------------------
# "dicta" enables the Dicta Nakdan provider. Unset = mock (text is returned
# unchanged and never stored as vocalized text).
# NIKUD_PROVIDER=dicta
# Default: https://nakdan-u2-1a.loadbalancer.dicta.org.il/api
# This is the unauthenticated endpoint behind Dicta's own web tool (no key);
# it is not a contracted API and may change or be rate limited.
# DICTA_API_URL=

# --- AI: text to speech ------------------------------------------------------------------
# Unset = mock (silent audio with evenly spaced word timings, shown with a
# "demo voice" notice). The only implemented vendor is "elevenlabs"; any other
# value throws a clear error.
# TTS_PROVIDER=elevenlabs
# ElevenLabs API key.
# TTS_API_KEY=
# REQUIRED with elevenlabs: a voice id. No default voice was chosen.
# TTS_VOICE=
# Optional data residency: us | eu | in | sg
# TTS_REGION=
# Default: eleven_v3 (a model that lists Hebrew)
# TTS_MODEL=
# Default: mp3_44100_128. Only mp3_* and wav_* formats are accepted.
# TTS_OUTPUT_FORMAT=
# 1 = send the text to the vendor without nikud.
# TTS_STRIP_NIKUD=1

# --- AI: illustrations ---------------------------------------------------------------------
# Unset = mock (a labelled SVG placeholder). The only implemented vendor is
# "gemini" (Google Interactions API); any other value throws
# ProviderNotImplementedError.
# IMAGE_PROVIDER=gemini
# A Google AI Studio key.
# IMAGE_API_KEY=
# Default: gemini-nano-banana-2.1
# IMAGE_MODEL=

# --- AI limits and scheduling ------------------------------------------------------------------
# AI books a parent may create per rolling 7 days. Default 1. Admins are unlimited.
# AI_WEEKLY_QUOTA=1
# Shared secret for the scheduled daily story. The scheduler calls
#   POST /api/generate/daily   with header   Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# --- Rate limits --------------------------------------------------------------------------------
# Requests per hour, per signed-in user (per IP address for anonymous callers).
# Editors and admins are not limited. A whole number; 0 blocks the endpoint,
# "off" removes the limit. The values below are the defaults.
# NOTE: the counters live in the memory of one server process. With several
# instances each one counts separately; see "Known gaps" in README.md.
# RATE_LIMIT_NARRATION_PER_HOUR=30
# RATE_LIMIT_NIKUD_PER_HOUR=400
# RATE_LIMIT_OCR_PER_HOUR=150
# RATE_LIMIT_TRANSLATE_PER_HOUR=60
# RATE_LIMIT_PDF_PER_HOUR=60
# RATE_LIMIT_VIEWS_PER_HOUR=120
# Voice ids a narration request may choose besides TTS_VOICE (comma separated).
# Any other voice id is refused.
# TTS_ALLOWED_VOICES=

# --- Free book import ---------------------------------------------------------------------------
# Optional GitHub token for the Book Dash importer (npm run import:bookdash, /admin/import).
# It only raises the limit of the catalogue listing (60 requests an hour without it).
# GITHUB_TOKEN=
